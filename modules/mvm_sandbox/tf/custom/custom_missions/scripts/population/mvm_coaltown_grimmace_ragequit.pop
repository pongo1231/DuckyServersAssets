			}
		}
	}
	Mission // Sniper Expert - waves 6-10
	{
		Objective Sniper

		InitialCooldown 40
		Where spawnbot_mission_sniper
		BeginAtWave 6
		RunForThisManyWaves 5
		CooldownTime 22
		DesiredCount 3

		TFBot
		{
			Class Sniper
			Skill Expert
			Name "Deadeye"
			MaxVisionRange 3000
			Item "The Razorback"
			Item "Soldered Sensei"
		}
	}
	Mission // Sniper Expert - waves 1-10 (extra pressure)
	{
		Objective Sniper

		InitialCooldown 30
		Where spawnbot_mission_sniper
