#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{

	StartingCurrency		400
	RespawnWaveTime 		4
	CanBotsAttackWhileInSpawnRoom no

	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 5
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 10

		CooldownTime 7

            TFBot
			{
				Template T_TFBot_SentryBuster
            }
	}
	Mission // Spy - waves 1-4
	{
		Objective Spy  

		InitialCooldown 40
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 4
		CooldownTime 12
		DesiredCount 8

		TFBot
		{
			Class Spy
			Skill Expert
			Name "Phantom Blade"
		}
	}
	Mission // Spy - waves 5-10
	{
		Objective Spy  

		InitialCooldown 50
		Where spawnbot_mission_spy
		BeginAtWave 5
		RunForThisManyWaves 6
		CooldownTime 12
		DesiredCount 8

		TFBot
		{
			Class Spy
			Skill Expert
			Name "Shadow Stalker"
			Item "Backbiter's Billycock"
		}
	}
	Mission // Sniper Sydney Sleeper - waves 1-10
	{
		Objective Sniper

		InitialCooldown 50
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 6
		CooldownTime 18
		DesiredCount 3

		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
