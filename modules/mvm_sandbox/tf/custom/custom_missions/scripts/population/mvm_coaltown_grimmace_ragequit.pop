	//WAVE 1 "Blood Rush" - Vampire melee scouts + knockback scouts + bleed heavies ////////////////////////////////////////////
	Wave
	{
		StartWaveOutput
			{
				Target wave_start_relay
				Action Trigger
			}
		DoneOutput					
			{
				Target wave_finished_relay
				Action trigger
			}
		WaitWhenDone 60
		Checkpoint Yes
		Description "RAGE: #1: Blood Rush"
		Sound "Announcer.MVM_Final_Wave_Start"

		WaveSpawn // 45 Vampire Scouts - melee only, AlwaysCrit, heal on kill
		{
			Name "wave01a"
			Where spawnbot
			TotalCount 45
			MaxActive 13
			SpawnCount 6
			WaitBeforeStarting 0
			WaitBetweenSpawns 2
			TotalCurrency 200

			Support 1
		
			TFBot
			{
				Class Scout
				Skill Hard
				Name "Blood Leech"
				Item "Bonk Helm"
				WeaponRestrictions MeleeOnly
				Attributes AlwaysCrit
				ItemAttributes
				{
					ItemName "TF_WEAPON_BAT"
					"heal on hit for slowfire" 52.5
				}
				CharacterAttributes
				{
					"move speed bonus" 1.76
				}
			}
		}
