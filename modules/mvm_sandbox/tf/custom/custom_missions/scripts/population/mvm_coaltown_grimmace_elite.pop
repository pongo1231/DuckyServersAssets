#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{

	StartingCurrency		400
	RespawnWaveTime 		5
	CanBotsAttackWhileInSpawnRoom no

	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 5
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 10

		CooldownTime 10            

            TFBot
			{
				Template T_TFBot_SentryBuster
            }
	}
	Mission // Spy - waves 1-4
	{
		Objective Spy  

		InitialCooldown 40
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 4
		CooldownTime 30
		DesiredCount 7

		TFBot
		{
			Class Spy
			Skill Expert
			Name "Phantom Blade"
		}
	}
	Mission // Spy - waves 5-10
	{
		Objective Spy  

		InitialCooldown 50
		Where spawnbot_mission_spy
		BeginAtWave 5
		RunForThisManyWaves 6
		CooldownTime 25
		DesiredCount 9

		TFBot
		{
			Class Spy
			Skill Expert
			Name "Shadow Stalker"
			Item "Backbiter's Billycock"
		}
	}
	Mission // Sniper Sydney Sleeper - waves 1-10
	{
		Objective Sniper

		InitialCooldown 50
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 6
		CooldownTime 18
		DesiredCount 7

		TFBot
		{
			Template T_TFBot_Sniper_Sydney_Sleeper
			Item "The Razorback"
			Item "Master's Yellow Belt"
			ItemAttributes
			{
				ItemName "The Sydney Sleeper"
				"faster reload rate" 1.4
				"projectile speed increased" 1.3
			}
		}
	}
	Mission // Sniper Expert - waves 6-10
	{
		Objective Sniper

		InitialCooldown 40
		Where spawnbot_mission_sniper
		BeginAtWave 6
		RunForThisManyWaves 5
		CooldownTime 22
		DesiredCount 7

		TFBot
		{
			Class Sniper
			Skill Expert
			Name "Deadeye"
			MaxVisionRange 3000
			Item "The Razorback"
			Item "Soldered Sensei"
		}
	}

	//WAVE 1 "Blood Rush" - Vampire melee scouts + knockback scouts + bleed heavies ////////////////////////////////////////////
	Wave
	{
		StartWaveOutput
			{
				Target wave_start_relay
				Action Trigger
			}
		DoneOutput					
			{
				Target wave_finished_relay
				Action trigger
			}
		WaitWhenDone 60
		Checkpoint Yes
		Description "#1: Blood Rush"

		WaveSpawn // 30 Vampire Scouts - melee only, AlwaysCrit, heal on kill
		{
			Name "wave01a"
			Where spawnbot
			TotalCount 41
			MaxActive 12
			SpawnCount 6
			WaitBeforeStarting 0
			WaitBetweenSpawns 2
			TotalCurrency 200
		
			TFBot
			{
				Class Scout
				Skill Hard
				Name "Blood Leech"
				Item "Bonk Helm"
				WeaponRestrictions MeleeOnly
				Attributes AlwaysCrit
				ItemAttributes
				{
					ItemName "TF_WEAPON_BAT"
					"heal on hit for slowfire" 47.25
				}
				CharacterAttributes
				{
					"move speed bonus" 1.1
				}
			}
		}
		WaveSpawn // 24 Knockback Scouts - scattergun with Force-A-Nature knockback
		{
			Name "wave01b"
			Where spawnbot_invasion
			TotalCount 33
			MaxActive 9
			SpawnCount 4
			WaitBeforeStarting 5
			WaitBetweenSpawns 4
			TotalCurrency 150
	
			TFBot
			{
				Class Scout
				Skill Hard
				Name "Shock Trooper"
				ItemAttributes
				{
					ItemName "TF_WEAPON_SCATTERGUN"
					"bullets per shot bonus" 1.5
					"scattergun has knockback" 1
					"damage penalty" 0.8775
				}
				CharacterAttributes
				{
					"move speed bonus" 1.15
				}
			}
		}
		WaveSpawn // 10 Bleeder Heavies - Fist + bleeding on hit
		{
			Name "wave01c"
			Where spawnbot
			TotalCount 14
			MaxActive 8
			SpawnCount 3
