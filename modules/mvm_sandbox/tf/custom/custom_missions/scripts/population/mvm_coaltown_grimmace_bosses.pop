#base robot_giant.pop
#base robot_standard.pop

WaveSchedule
{

	StartingCurrency		1500
	RespawnWaveTime 		7
	CanBotsAttackWhileInSpawnRoom no

	Mission // sentry buster
	{
		Objective DestroySentries

		InitialCooldown 5
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 10

		CooldownTime 40

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	//WAVE 1 "Doomguy" ////////////////////////////////////////////////////////////////////////////////////////////
	Wave
	{
		StartWaveOutput
			{
				Target wave_start_relay
				Action Trigger
			}
		DoneOutput					
			{
				Target wave_finished_relay
				Action trigger
			}
		WaitWhenDone 30
		Checkpoint Yes
		Description "BOSS #1: Doomguy"
		Sound "Announcer.MVM_Final_Wave_Start"

		WaveSpawn // 8 Fist Heavy escorts
		{
			Name "boss01a"
			Where spawnbot
			TotalCount 8
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 3
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Heavyweapons_Fist
				Name "Hell Brute"
				Item "Hound Dog"
				Attributes AlwaysCrit
			}
		}
		WaveSpawn // Doomguy - Giant Heavy, AlwaysCrit, push, fast, high damage
		{
			Name "boss01b"
			Where spawnbot_giant
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 12
			WaitBetweenSpawns 0
			TotalCurrency 400

			TFBot
			{
				Template T_TFBot_Giant_Heavyweapons
				Name "Doomguy"
				Item "Point and Shoot"
				Attributes AlwaysCrit
				BehaviorModifiers push
				CharacterAttributes
				{
					"move speed bonus" 1.4
					"damage bonus" 1.6
					"damage force reduction" 0.3
				}
				ItemAttributes
				{
					ItemName "TF_WEAPON_MINIGUN"
					"health on kill" 100
				}
			}
		}
	}

